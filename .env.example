# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# The launcher accepts either GOOGLE_CLIENT_* or GMAIL_CLIENT_* variable names.
GOOGLE_CLIENT_ID=your Google Client ID here
GOOGLE_CLIENT_SECRET=your Google Client Secret here
GOOGLE_REDIRECT_URI=your Google Redirect URI here

# Optional. The local launcher generates a random per-run value when unset.
GMAIL_SESSION_SECRET=

APP_BASE_URL=base url of your app here 